# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Feature Flags
ENABLE_CONFIG_ENDPOINT=true

# Supabase Database & Auth
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-for-local-development
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-chars-long

# Microservices & External APIs
COMPILER_SERVICE_URL=https://latexai-compiler.onrender.com
GROQ_API_KEY=gsk_placeholder_groq_api_key
